// =============================================================================
// AGENT BRICKS — a multi-agent "Agent Bricks" architecture over a governed
// medallion + a document Knowledge Assistant.
//
// JSONC (JSON + // comments) for YOU to read. Emit PLAIN JSON (strip //) in the
// architecture.md ```json fence.
//
// WHAT IT SHOWS:
//   • rowGrid layout — `row` aligns across ALL lanes into shared FIXED-PITCH
//     bands (a tall node overflows in its own column, it does NOT push others):
//       row 1              Genie Agent
//       row 2              AI/BI Dashboard      Genie One (entry)
//       row 3   Postgres · Medallion · Hosted MCPs · Supervisor Agent
//       row 4   PDF docs ·               Knowledge Assistant
//     The three SUPERVISOR TOOLS (Genie · Hosted MCPs · Knowledge Assistant)
//     stack in the `tools` lane; the Supervisor sits centered against them and
//     fans them in (the dashboard is a consumption surface → Genie One, not a
//     Supervisor tool). Postgres (row 3) lines up with the medallion, PDF
//     (row 4) with the Knowledge Assistant it feeds — clean horizontal feeds.
//   • A governed medallion (`medallion-table`, params.metric_views on) forks a
//     Metric Views layer off GOLD and exposes `@out-gold` + `@out-mv`:
//       – Genie Agent reads GOLD (`@out-gold` → genie).
//       – the AI/BI Dashboard reads the METRIC VIEWS (`@out-mv` → dashboard).
//   • PDF documents feed the Knowledge Assistant DIRECTLY (unstructured RAG),
//     NOT through the medallion.
//   • A Supervisor Agent orchestrates the three tools (Knowledge Assistant ·
//     Genie Agent · Hosted MCPs) and serves business users through Genie One.
//   • A `governance-block` GOVERNANCE BAR pinned across the top — access-control
//     + Genie Ontology surfaces on (AI Gateway HIDDEN via params, since the
//     agent layer already represents model access here). Its edges are DASHED +
//     arrow-ended (governance governs, it doesn't flow data) and leave the
//     BOTTOM handles (`@acl-b` / `@ontology-b`) to drop onto what they govern.
//
// AUTHOR STRUCTURE, NOT PIXELS. See the medallion catalog row for the
// `@out-gold` / `@out-mv` / `@l` handles, and the governance-block row for its
// `@acl` / `@ontology` surface handles (+ `-b` for the bottom).
// =============================================================================
[
  {
    "name": "Agent Bricks",
    "story": "Ingest our Postgres data into a governed medallion (bronze→silver→gold) with a Metric Views layer; a Genie Agent queries the gold tables and an AI/BI dashboard reads the governed metric views. Separately, our PDF documents feed a Knowledge Assistant for grounded Q&A. A Supervisor Agent orchestrates the Knowledge Assistant, Genie Agent, and hosted MCP tools, and serves answers to business users through Genie One.",
    "columns": ["sources", "pipeline", "tools", "supervisor", "entry"],
    "rowGrid": true,
    "nodes": [
      { "id": "src-postgres", "type": "source", "col": "sources", "row": 3, "label": "Postgres", "icon": "file:vendor/postgresql" },
      { "id": "src-pdf", "type": "source", "col": "sources", "row": 4, "label": "PDF documents", "icon": "pdfLogo",
        "ai_reasoning": "PDFs feed the Knowledge Assistant DIRECTLY (unstructured RAG) — NOT through the medallion. Placed on row 4 to line up with the Knowledge Assistant." },
      { "id": "medallion-table", "type": "medallion-table", "col": "pipeline", "row": 3, "params": { "metric_views": true },
        "ai_reasoning": "params.metric_views on → a Metric Views fork off GOLD + the `@out-mv` handle (plus the always-present `@out-gold`). Genie reads gold, the dashboard reads metric views." },

      { "id": "genie", "type": "genie", "col": "tools", "row": 1 },
      { "id": "ai-bi-dashboard", "type": "ai-bi-dashboard", "col": "tools", "row": 2,
        "ai_reasoning": "In the `tools` lane, fed by the metric views — a consumption surface wired straight to Genie One (NOT a Supervisor tool)." },
      { "id": "hosted-mcps", "type": "hosted-mcps", "col": "tools", "row": 3,
        "ai_reasoning": "A Supervisor tool. Tools fan INTO the Supervisor on the right; Hosted MCPs = the agent's external-tool reach." },
      { "id": "knowledge-assistant", "type": "knowledge-assistant", "col": "tools", "row": 4,
        "ai_reasoning": "Row 4 to line up with the PDF source that feeds it. Managed RAG over the docs (no separate Vector Search node needed — KA handles chunk/index/retrieve)." },

      { "id": "supervisor-agent", "type": "supervisor-agent", "col": "supervisor", "row": 3,
        "ai_reasoning": "In the `supervisor` lane, sitting against the tool stack it fans in from so the inbound `@l` edges stay balanced." },
      { "id": "genie-one", "type": "genie-one", "col": "entry", "row": 2, "rot": 90,
        "ai_reasoning": "Business-user entry point — the persona pill is built INTO the tile (no separate user node). Rotated 90° into a slim right-hand lane. Its inbound edges (from Supervisor + Dashboard) auto-arrow — leave `arrow`/`flow` off." },

      { "id": "db-platform", "type": "db-platform", "pin": { "at": "top-left", "to": "platform-box" } },
      { "id": "governance-block", "type": "governance-block", "pin": { "at": "top", "to": "platform-box" },
        "params": { "ai_gateway": false, "genie_ontology": true },
        "desc": "Unity Catalog governs access, lineage and quality across every table.",
        "ai_reasoning": "Governance bar pinned across the top. AI Gateway surface HIDDEN (ai_gateway:false) — the agent layer already represents model access here, so repeating the gateway would be redundant; keep access-control + Genie Ontology. Its edges leave the BOTTOM handles (`@acl-b`/`@ontology-b`) and are dashed + arrow-ended automatically." },
      { "id": "platform-box", "type": "box", "pad": 40,
        "wraps": ["medallion-table", "genie", "ai-bi-dashboard", "hosted-mcps", "knowledge-assistant", "supervisor-agent", "genie-one"],
        "ai_reasoning": "Wraps all on-platform components; the two data SOURCES are intentionally left out so they read as external systems feeding in. Auto-renders behind its children (no z needed)." }
    ],
    "edges": [
      { "id": "e-pg-med", "from": "src-postgres@r", "to": "medallion-table@l", "flow": true },
      { "id": "e-pdf-ka", "from": "src-pdf@r", "to": "knowledge-assistant@l", "flow": true, "label": "Split and index documents" },
      { "id": "e-med-genie", "from": "medallion-table@out-gold", "to": "genie@l", "flow": true, "label": "Query gold" },
      { "id": "e-med-dash", "from": "medallion-table@out-mv", "to": "ai-bi-dashboard@l", "flow": true, "label": "Aggregations" },
      { "id": "e-ka-sup", "from": "knowledge-assistant@r", "to": "supervisor-agent@l", "flow": true },
      { "id": "e-genie-sup", "from": "genie@r", "to": "supervisor-agent@l", "flow": true },
      { "id": "e-mcp-sup", "from": "hosted-mcps@r", "to": "supervisor-agent@l", "flow": true },
      { "id": "e-sup-genieone", "from": "supervisor-agent@r", "to": "genie-one@l" },
      { "id": "e-dash-genieone", "from": "ai-bi-dashboard@r", "to": "genie-one@l" },
      // Governance surfaces → what they govern. Dashed + arrow-ended is automatic
      // for governance edges; leaving the BOTTOM handles so they drop down onto
      // the tiles below the bar.
      { "id": "e-gov-acl", "from": "governance-block@acl-b", "to": "medallion-table@t", "label": "Secure access" },
      { "id": "e-gov-ontology", "from": "governance-block@ontology-b", "to": "genie@t", "label": "access enterprise context" }
    ]
  }
]

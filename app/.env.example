# =============================================================================
# Databricks Asset Generator - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Lakebase database to connect to. Full path:
#   projects/<project-id>/branches/<branch-id>/databases/<db-name>
# OAuth tokens are minted automatically via the Databricks SDK auth chain
# (your DATABRICKS_CONFIG_PROFILE locally; the App SP in prod). No password.
#
# To skip Lakebase entirely and run a local Postgres, leave LAKEBASE_DATABASE_PATH
# unset OR set USE_PGLITE=1 — the app falls back to a self-managed PGLite cluster.
# LAKEBASE_DATABASE_PATH=projects/.../branches/.../databases/demo_generator
# USE_PGLITE=1

# -----------------------------------------------------------------------------
# Databricks Authentication (choose ONE method)
# -----------------------------------------------------------------------------
# The app uses the Databricks Python SDK unified authentication.
# Authentication is checked in this order:
#
# 1. PROFILE-BASED (recommended for local dev):
#    Set DATABRICKS_CONFIG_PROFILE to use a profile from ~/.databrickscfg
#    First run: databricks auth login --host <workspace-url> --profile <name>
DATABRICKS_CONFIG_PROFILE=DEFAULT

# 2. DIRECT TOKEN AUTH:
#    Set host and token directly (useful for CI/CD or if you don't want profiles)
# DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# DATABRICKS_TOKEN=dapi...

# -----------------------------------------------------------------------------
# LLM Configuration
# -----------------------------------------------------------------------------
# Model name passed by Claude Code as Anthropic `model` field. In prod
# this is set by databricks.prod.yml's `app_env:` block.
ANTHROPIC_LLM_ENDPOINT=databricks-claude-sonnet-4-6

# URL path Claude Code uses for ANTHROPIC_BASE_URL:
#   `serving-endpoints/anthropic` → FMAPI default Anthropic bridge
#                                   (works with built-in databricks-claude-*)
#   `ai-gateway/anthropic`        → AI Gateway Anthropic shim
#                                   (works with custom AI Gateway endpoints)
ANTHROPIC_BASE_PATH=serving-endpoints/anthropic

# AI Gateway endpoints (SDK auth + routing via serving_endpoints.get_open_ai_client()).
# Set the same values you use in databricks.prod.yml.
AI_GATEWAY_MINI=databricks-gpt-5-4-mini
AI_GATEWAY=databricks-claude-opus-4-7
AI_GATEWAY_EMBEDDING=databricks-qwen3-embedding-0-6b

# -----------------------------------------------------------------------------
# Default Catalog
# -----------------------------------------------------------------------------
# Unity Catalog every new project lands in. Created at app boot if missing,
# with `USE CATALOG` + `CREATE SCHEMA` granted to `account users` and
# `ALL PRIVILEGES` granted to each admin in DEMO_PROMPT_GENERATOR_TEMPLATE_ADMIN_EMAILS.
# Set to your team's shared catalog if `ai_demo_gen` doesn't work for you.
DEFAULT_CATALOG=ai_demo_gen

# -----------------------------------------------------------------------------
# Template Admins
# -----------------------------------------------------------------------------
# Comma-separated emails granted admin rights: `ALL PRIVILEGES` on DEFAULT_CATALOG
# (see above) plus the ability to review/approve templates published to the
# gallery. Leave blank for no admins. In prod, set the same value in
# databricks.prod.yml's `app_env:` block.
#   e.g. DEMO_PROMPT_GENERATOR_TEMPLATE_ADMIN_EMAILS=you@example.com,teammate@example.com
DEMO_PROMPT_GENERATOR_TEMPLATE_ADMIN_EMAILS=

# -----------------------------------------------------------------------------
# Cross-workspace deploy (OFF by default)
# -----------------------------------------------------------------------------
# Everything below is ADDITIVE and OFF unless set. With none of these keys the
# app is the classic single-workspace app (deploys generated demos into the
# app's own workspace as the signed-in user). Activation is purely by these env
# vars, so the same build ships publicly (keys unset = feature invisible) and you
# opt in locally/in prod by filling them in. In a deployed App set the same keys
# in databricks.<target>.yml's `app_env:` block (secrets via a secret scope).
#
# cross_workspace_deploy_enabled  ← BOTH of the two DEPLOYER_SP_* keys set.
#     Turns on the deployer-SP deploy path (agent deploys AS this SP INTO a
#     remote target workspace) AND surfaces the account-level "deploy target"
#     control on the home page (paste a workspace URL). Leave either blank → the
#     whole path is off and the control is hidden.
#     The SP secret should come from a secret scope in any real deploy, not an
#     inline value. Create the SP once; it must be a workspace admin on each
#     target workspace it deploys into.
# DEPLOYER_SP_CLIENT_ID=00000000-0000-0000-0000-000000000000
# DEPLOYER_SP_CLIENT_SECRET=dose...
#
#     Optional: the shared default target host pre-filled for users who haven't
#     picked their own (an https:// workspace URL). Blank → each user deploys to
#     the app's own workspace until they set a target.
# DEFAULT_TARGET_WORKSPACE_HOST=https://your-workspace.cloud.databricks.com

# -----------------------------------------------------------------------------
# Databricks Agent Skills (DAS) Configuration
# -----------------------------------------------------------------------------
# Branch of github.com/databricks/databricks-agent-skills that dev.sh clones into
# ./databricks_agent_skill/. Alias: DATABRICKS_AGENT_SKILL_BRANCH (either works).
DAS_BRANCH=main

# -----------------------------------------------------------------------------
# Usage Analytics (dbdemos-tracker) — ON BY DEFAULT
# -----------------------------------------------------------------------------
# Sends aggregated, anonymized usage events (page views, feature counts) to
# Databricks for product improvement only — never for sales contact.
#
# The dbdemos-tracker package filters events at the source: only @databricks.com
# users send anything. External installations effectively send no telemetry,
# but the middleware is still registered. Set this to 0 to disable it entirely.
#
# Full list of fields collected: see PRIVACY.md at the repo root.
DEMO_PROMPT_GENERATOR_TRACKER_ENABLED=1
